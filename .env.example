APP_ENV=development
LOG_LEVEL=info

WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

DATABASE_URL=postgresql://repovista:repovista@localhost:5432/repovista
DATABASE_MAX_CONNECTIONS=10

MODEL_PROVIDER=fake
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
CHAT_MODEL=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_INPUT_MAX_CHARS=12000
EMBEDDING_REQUEST_TIMEOUT_MS=60000
OLLAMA_BASE_URL=http://localhost:11434

REPOSITORY_ALLOWED_HOSTS=github.com
REPOSITORY_MAX_FILES=10000
REPOSITORY_MAX_BYTES=524288000
SOURCE_FILE_MAX_BYTES=2097152
JOB_TIMEOUT_SECONDS=900
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=30
WORKER_ID=local-worker
RUN_MIGRATIONS_ON_START=false
DEMO_SEED_ENABLED=false

ANONYMOUS_IMPORTS_PER_HOUR=3
ANONYMOUS_QUESTIONS_PER_HOUR=10
SHARE_REPORTS_PER_HOUR=10

# Signed GitHub webhooks and optional GitHub App private-repository access.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=repovista-local
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OAUTH_ORIGIN=https://github.com
GITHUB_WEBHOOK_BODY_MAX_BYTES=1048576

# First-party auth. Keep OAuth secrets, App IDs, and PEM private keys in the deployment secret manager.
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_OAUTH_STATE_TTL_SECONDS=600
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_TTL_DAYS=90
AUTH_ALLOW_SIGNUP=true

# Production deployments must use HTTPS origins and AUTH_COOKIE_SECURE=true.

# Optional read-only token for higher public GitHub API rate limits during PR analysis.
GITHUB_API_TOKEN=
GITHUB_API_ORIGIN=https://api.github.com
