{
  "name": "@repovista/database",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "build:runtime": "tsup src/index.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@repovista/config": "workspace:*",
    "@repovista/contracts": "workspace:*",
    "@repovista/domain": "workspace:*",
    "@repovista/impact": "workspace:*",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0"
  }
}
