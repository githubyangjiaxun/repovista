{
  "name": "@repovista/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --platform node --sourcemap --no-splitting",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@repovista/ai": "workspace:*",
    "@repovista/config": "workspace:*",
    "@repovista/contracts": "workspace:*",
    "@repovista/database": "workspace:*",
    "@repovista/domain": "workspace:*",
    "@repovista/git": "workspace:*",
    "@repovista/retrieval": "workspace:*",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "zod": "^4.0.0"
  }
}
