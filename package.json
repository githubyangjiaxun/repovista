{
  "name": "repovista",
  "version": "0.2.0",
  "private": true,
  "description": "Understand any codebase as a map, not a maze.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --parallel --env-mode=loose",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @repovista/web test:e2e",
    "check": "pnpm openapi:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @repovista/database migrate",
    "db:seed": "pnpm --filter @repovista/database seed",
    "benchmark": "pnpm --filter @repovista/benchmarks benchmark"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.0.18",
    "tsup": "8.5.1",
    "turbo": "2.6.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
